.page {
  background: #1f1f1f;
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.loading {
  color: #999;
  text-align: center;
  margin-top: 200rpx;
  font-size: 28rpx;
}

.status-card {
  border-radius: 16rpx;
  padding: 40rpx 24rpx;
  text-align: center;
  margin-bottom: 24rpx;
  background: #2b2b2b;
}

.status-text {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
}

.status-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  display: block;
}

.status-pending .status-text { color: #f5a623; }
.status-approved .status-text { color: #4cd964; }
.status-rejected .status-text { color: #ff4d4d; }
.status-withdrawn .status-text { color: #888; }

.row-value.status-pending { color: #f5a623; }
.row-value.status-approved { color: #4cd964; }
.row-value.status-rejected { color: #ff4d4d; }
.row-value.status-withdrawn { color: #888; }

.actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 8rpx;
}

.share-btn {
  flex: 1;
  background: #07c160;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.withdraw-btn {
  flex: 1;
  background: transparent;
  color: #ff4d6d;
  border: 1rpx solid #ff4d6d;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.card {
  background: #2b2b2b;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  color: #999;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #363636;
}

.row:last-child {
  border-bottom: none;
}

.row-label {
  color: #999;
  font-size: 26rpx;
}

.row-value {
  color: #fff;
  font-size: 28rpx;
  text-align: right;
  max-width: 65%;
}

.row-value.price {
  color: #ff4d6d;
  font-weight: 600;
}

.row-value.link {
  color: #58a6ff;
}
