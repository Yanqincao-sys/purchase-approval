.page {
  background: #1f1f1f;
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.section {
  background: #2b2b2b;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.hint {
  color: #999;
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.label-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 12rpx;
}

.required-mark {
  color: #ff4d4d;
  font-size: 26rpx;
  margin-right: 6rpx;
}

.label-text {
  color: #ccc;
  font-size: 26rpx;
}

.input {
  background: #1f1f1f;
  color: #fff;
  border-radius: 10rpx;
  padding: 18rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.btn {
  border-radius: 40rpx;
  font-size: 28rpx;
}

.btn.primary {
  background: #ff4d6d;
  color: #fff;
}

.btn.small {
  font-size: 24rpx;
  padding: 0 24rpx;
  height: 60rpx;
  line-height: 60rpx;
  background: #444;
  color: #fff;
}

.share-row {
  margin-top: 16rpx;
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.share-row .btn {
  flex: 1;
  text-align: center;
}

.qrcode-box {
  margin-top: 20rpx;
  background: #1f1f1f;
  border-radius: 10rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qrcode-img {
  width: 280rpx;
  height: 280rpx;
}

.qrcode-hint {
  color: #999;
  font-size: 22rpx;
  margin-top: 12rpx;
  text-align: center;
}

.scan-banner {
  background: rgba(76, 217, 100, 0.15);
  border: 1px solid rgba(76, 217, 100, 0.4);
  border-radius: 10rpx;
  padding: 16rpx;
  color: #4cd964;
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.divider {
  height: 1px;
  background: #333;
  margin: 8rpx 0 24rpx;
}

.approver-item {
  color: #eee;
  font-size: 26rpx;
  padding: 16rpx 0;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #333;
}

.approver-item:last-child {
  border-bottom: none;
}

.approver-name {
  flex: 1;
}

.remove-btn {
  color: #ff4d4d;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  flex-shrink: 0;
}
