.page {
  background: #1f1f1f;
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.form-card {
  background: #2b2b2b;
  border-radius: 16rpx;
  padding: 24rpx;
}

.edit-banner {
  background: rgba(245, 166, 35, 0.15);
  border: 1px solid rgba(245, 166, 35, 0.4);
  color: #f5a623;
  font-size: 24rpx;
  line-height: 1.5;
  border-radius: 10rpx;
  padding: 16rpx;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.label {
  color: #bbbbbb;
  font-size: 26rpx;
  margin-bottom: 12rpx;
  display: block;
}

.input, .picker {
  background: #1f1f1f;
  color: #fff;
  border-radius: 10rpx;
  padding: 18rpx;
  font-size: 28rpx;
}

.textarea {
  background: #1f1f1f;
  color: #fff;
  border-radius: 10rpx;
  padding: 18rpx;
  font-size: 28rpx;
  width: 100%;
  min-height: 140rpx;
  box-sizing: border-box;
}

.submit-btn {
  margin-top: 32rpx;
  background: #ff4d6d;
  color: #fff;
  border-radius: 40rpx;
}

.tip {
  color: #777;
  font-size: 22rpx;
  text-align: center;
  margin-top: 20rpx;
}

.tip.link {
  color: #58a6ff;
  margin-top: 16rpx;
}

.picker.no-approver {
  color: #f5a623;
}

.success-card {
  background: #2b2b2b;
  border-radius: 16rpx;
  padding: 40rpx 24rpx;
  text-align: center;
}

.success-title {
  color: #4cd964;
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.success-desc {
  color: #999;
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.share-btn {
  background: #07c160;
  color: #fff;
  border-radius: 40rpx;
  margin-bottom: 20rpx;
}

.again-btn {
  background: #444;
  color: #fff;
  border-radius: 40rpx;
}
