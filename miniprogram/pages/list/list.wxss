.page {
  background: #1f1f1f;
  min-height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
}

.filter-bar {
  display: flex;
  flex-direction: row;
  background: #2b2b2b;
  border-radius: 40rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.filter-item {
  flex: 1;
  text-align: center;
  color: #999;
  font-size: 22rpx;
  padding: 14rpx 0;
  border-radius: 34rpx;
}

.filter-item.active {
  background: #ff4d6d;
  color: #fff;
  font-weight: 600;
}

.empty {
  color: #888;
  text-align: center;
  margin-top: 200rpx;
  font-size: 26rpx;
}

.card {
  background: #2b2b2b;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-title {
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.row {
  display: flex;
  flex-direction: row;
  margin-bottom: 14rpx;
}

.row-label {
  color: #999;
  font-size: 26rpx;
  width: 160rpx;
  flex-shrink: 0;
}

.row-value {
  color: #eee;
  font-size: 26rpx;
  flex: 1;
}

.status-pending { color: #f5a623; }
.status-approved { color: #4cd964; }
.status-rejected { color: #ff4d4d; }
.status-withdrawn { color: #888; }

.card-actions {
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #3a3a3a;
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
}

.withdraw-btn {
  color: #ff4d6d;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border: 1rpx solid #ff4d6d;
  border-radius: 30rpx;
}
